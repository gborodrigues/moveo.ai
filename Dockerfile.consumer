FROM golang:1.22-alpine AS build
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/consumer ./cmd/consumer
RUN go build -o /out/consumer ./cmd/consumer

FROM alpine:3.20
RUN adduser -D -g '' appuser
USER appuser
COPY --from=build /out/consumer /usr/local/bin/consumer
CMD ["/usr/local/bin/consumer"]
